# Public site URL — used for absolute links. In Vercel, set to your domain (e.g. https://dashboard-metads2.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: copy from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

# Service role key — REQUIRED for admin writes and click event logging.
# WARNING: never expose this to the browser. It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_me

# Long random string used to hash IPs for click events and to derive secrets. Generate one fresh.
IP_HASH_SALT=replace-with-long-random-secret
API_KEY_SECRET=replace-with-long-random-secret
